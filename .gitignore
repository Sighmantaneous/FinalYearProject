# ---- ESP-IDF / build artifacts ----
# Generated build output (regenerated by `idf.py build`). Machine-specific,
# large, and contains absolute paths — never commit.
build/
**/build/

# Previous sdkconfig snapshot created by menuconfig. The active `sdkconfig`
# and `sdkconfig.defaults*` ARE committed; the .old backup is not.
sdkconfig.old
**/sdkconfig.old

# ESP-IDF managed components lockfile cache
**/managed_components/
dependencies.lock

# ---- Editor / tooling ----
# clangd compilation database (generated per machine via `idf.py reconfigure`)
compile_commands.json
**/compile_commands.json
.cache/

# ---- Python (Pi gateway, test scripts) ----
.venv/
venv/
__pycache__/
*.pyc

# ---- Node (dashboard) ----
node_modules/

# ---- OS / misc ----
.DS_Store
*.swp
